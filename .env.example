API_HOST=0.0.0.0
API_PORT=8100
ENVIRONMENT=development
DATABASE_URL=sqlite:///./helpdeskflow.db
# For PostgreSQL with pgvector:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/helpdeskflow

# LLM Configuration
LLM_PROVIDER=mock
# Available providers: mock, gemini, groq, openrouter, ollama
LLM_MODEL=default
LLM_CACHE_DIR=.cache/llm_cache
LLM_REQUEST_TIMEOUT_SECONDS=30

# Optional API Keys for hosted providers
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Guardrail & Policy Budgets
MAX_TOOL_CALLS_PER_TICKET=5
MAX_TOKENS_PER_TICKET=4096
CONFIDENCE_THRESHOLD_APPROVAL=0.75
